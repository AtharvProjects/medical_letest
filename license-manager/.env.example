# Server Port (Render sets this automatically to 10000)
PORT=4000

# Admin Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# JWT Secret for Session Tokens
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Optional: Cloud PostgreSQL Database URL (100% Free with Neon.tech or Supabase)
# If left empty, uses local SQLite database (licenses.db)
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Optional: Custom RSA Private Key in PEM format (Render can take this as an environment variable)
# If not set, reads from ./private.pem
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
